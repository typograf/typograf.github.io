{
  "name": "typograf.github.io",
  "description": "Web interface for Typograf",
  "version": "1.0.0",
  "author": {
    "name": "Denis Seleznev",
    "email": "hcodes@yandex.ru",
    "url": "https://github.com/typograf/typograf.github.io/"
  },
  "private": true,
  "homepage": "https://github.com/typograf/typograf.github.io/",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/typograf/typograf/blob/master/LICENSE"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/typograf/typograf.github.io.git"
  },
  "keywords": [
    "typo",
    "text",
    "typograf",
    "typographer",
    "typography"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "autoprefixer": "^10.6.2",
    "copy-text-to-clipboard": "^3.2.2",
    "cssnano": "^9.9.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "eslint": "^10.14.0",
    "eyo-kernel": "^4.1.3",
    "globals": "^17.14.0",
    "js-beautify": "^2.0.3",
    "jsdom": "^30.1.3",
    "lyam": "^3.2.3",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "postcss-inline-svg": "^6.0.0",
    "postcss-nested": "^9.0.1",
    "preact": "^11.1.1",
    "preact-render-to-string": "^6.8.2",
    "rollup": "^4.67.4",
    "rollup-plugin-postcss": "^4.0.2",
    "terser": "^5.51.2",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "typograf": "^7.8.0",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "copy:html-beautify": "terser ./node_modules/js-beautify/js/lib/beautify-html.js > ./dist/html-beautify.js",
    "copy:eyo": "terser ./node_modules/eyo-kernel/dist/bundle.safe.js > ./dist/eyo.js",
    "test": "npm run eslint && npm run typecheck && vitest run",
    "eslint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "rollup -c && node tools/build-ssr.mjs && node tools/index.mjs && npm run copy:html-beautify && npm run copy:eyo",
    "start": "lsof -ti:8000 | xargs kill -9; python3 -m http.server 8000 & open http://localhost:8000"
  }
}
